{
  "manifest_version": 3,
  "name": "AFSM",
  "description": "Inspect AFSM state machines",
  "version": "2.0.0",
  "author": "dexter",
  "icons": {
    "128": "logo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["clipboardWrite", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "devtools_page": "devtools-page.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
